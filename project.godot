; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="gamehub"
config/description="Hub de joguinhos de festa. Primeiro jogo: Chapéu."
config/version="1.0.0"
run/main_scene="res://app/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.960784, 0.937255, 0.890196, 1)
boot_splash/show_image=false
config/icon="res://design/store/icon_512.png"

[autoload]

Settings="*res://app/autoload/settings.gd"
Haptics="*res://app/autoload/haptics.gd"
Audio="*res://app/autoload/audio.gd"
History="*res://app/autoload/history.gd"
Net="*res://net/net.gd"
App="*res://app/autoload/app.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.960784, 0.937255, 0.890196, 1)
